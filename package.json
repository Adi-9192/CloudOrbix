{
  "name": "cloudorbix",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
        "node": "22.0.0"
      },"
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "nodemon server/index.js",
    "server": "node server/index.js",
    "migrate": "node server/migrate.js",
    "bootstrap-admin": "node server/bootstrap-admin.js",
    "build": "vite build",
    "test": "node --test server/lib/*.test.js",
    "preview": "vite preview",
    "format": "oxfmt"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.33.0",
    "@sentry/node": "^10.71.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.31.0",
    "multer": "^1.4.5-lts.2",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.7",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
